class RomanNumerals:
    @staticmethod
    def to_roman(val : int) -> str:
        roman_dict = {
            1 : "I",
            4 : "IV",
            5 : "V",
            9 : "IX",
            10 : "X",
            40 : "XL",
            50 : "L",
            90 : "XC",
            100 : "C",
            400 : "CD",
            500 : "D",
            900 : "CM",
            1000 : "M"
            }
        result = ""
        result_list=[]
        num_list = [int(n) for n in str(val)]
        for i,n in enumerate(num_list):
            value = n * (10 ** (len(num_list)-i-1))
            result_list.append(value)
            
        for r in result_list:
            if r == 0:
                continue

            if r in roman_dict:
                result += roman_dict[r]
                continue

            r_list = [int(n) for n in str(r)]
            x = r_list[0]

            if len(r_list) == 4:
                rv = x * roman_dict[1000]

            elif len(r_list) == 3:
                if x < 4:
                    rv = x * roman_dict[100]
                elif x == 4:
                    rv = roman_dict[400]
                elif x < 9:
                    rv = roman_dict[500] + ((x - 5) * roman_dict[100])
                else:
                    rv = roman_dict[900]

            elif len(r_list) == 2:
                if x < 4:
                    rv = x * roman_dict[10]
                elif x == 4:
                    rv = roman_dict[40]
                elif x < 9:
                    rv = roman_dict[50] + ((x - 5) * roman_dict[10])
                else:
                    rv = roman_dict[90]

            else:
                if x < 4:
                    rv = x * roman_dict[1]
                elif x == 4:
                    rv = roman_dict[4]
                elif x < 9:
                    rv = roman_dict[5] + ((x - 5) * roman_dict[1])
                else:
                    rv = roman_dict[9]

            result += rv

        return result
            

    @staticmethod
    def from_roman(roman_num : str) -> int:
        roman_dict = {
            "I": 1,
            "IV": 4,
            "V": 5,
            "IX": 9,
            "X": 10,
            "XL": 40,
            "L": 50,
            "XC": 90,
            "C": 100,
            "CD": 400,
            "D": 500,
            "CM": 900,
            "M": 1000
            }
        result = 0
        
        for i in range(len(roman_num) - 1):
            if roman_dict[roman_num[i]] < roman_dict[roman_num[i+1]]:
                result -= roman_dict[roman_num[i]]
            else:
                result += roman_dict[roman_num[i]]
            
        result += roman_dict[roman_num[-1]]
        return result
